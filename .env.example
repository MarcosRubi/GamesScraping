# Plantilla de variables del frontend. Copiala como:
#   .env.development  → npm run start:dev / npm run build:dev
#   .env.qa           → npm run start:qa  / npm run build:qa
# Esos archivos NO se suben al repo. En Docker se pasan como build args.

# URL base de la API (obligatoria)
API_URL=http://localhost:3000

# Analítica Umami (opcional: vacías = sin analítica)
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
